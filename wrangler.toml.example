name = "mailnest"
main = ".svelte-kit/cloudflare/_worker.js"
compatibility_date = "2025-04-01"
compatibility_flags = ["nodejs_compat"]
workers_dev = false

# Custom domain - DNS is auto-managed by Cloudflare
[[routes]]
pattern = "DASHBOARD_DOMAIN"
custom_domain = true

# Static assets (JS, CSS, images) served by the Worker
[assets]
directory = ".svelte-kit/cloudflare"
binding = "ASSETS"

[vars]
MAIL_DOMAIN = "example.com"
INTERNAL_SECRET = "GENERATE_ME"

# Telegram bot tokens are encrypted before being stored in D1.
# Configure this as a Worker secret, not as a checked-in var:
#   bunx wrangler secret put ENCRYPTION_KEY

# D1 Database binding
[[d1_databases]]
binding = "DB"
database_name = "mailnest-db"
database_id = "YOUR_D1_DATABASE_ID"

# (Optional) R2 Bucket for storing email attachments
# Without R2: emails still work, but attachment files can't be downloaded
# To enable: uncomment below and run: bunx wrangler r2 bucket create mailnest-attachments
# [[r2_buckets]]
# binding = "R2"
# bucket_name = "mailnest-attachments"
