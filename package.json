{
  "name": "mailnest",
  "version": "0.1.0",
  "description": "MailNest - Where your emails come home. A Cloudflare-powered email router & inbox dashboard.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:setup": "bunx wrangler d1 execute mailnest-db --local --file=./drizzle/migrations/0000_init.sql && echo '✓ Local DB ready. Run: bun run dev'",
    "build": "vite build && node ./scripts/postbuild-email-handler.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "bits-ui": "^2.17.3",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.3",
    "lucide-svelte": "^1.0.1",
    "postal-mime": "^2.7.4",
    "svelte": "^5.55.3",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260411.1",
    "@types/dompurify": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "wrangler": "^4.81.1"
  }
}
